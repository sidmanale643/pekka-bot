# Copy to .env and fill in.

# https://openrouter.ai/settings/keys
# The default for every run. People can instead save their own OpenRouter, OpenAI or
# Anthropic key in Settings, which needs PEKKA_PLUGIN_KEY (below) to store it encrypted.
OPENROUTER_API_KEY=

# https://app.daytona.io/dashboard/keys
# Each bot's computer is a Daytona sandbox. Without a key, it's a Docker container on
# the machine that runs Pekka, so Docker must be running there.
DAYTONA_API_KEY=

# The image for those Docker containers (optional).
# PEKKA_DOCKER_IMAGE=python:3.13-bookworm

# Web search: Tavily first, Exa if Tavily fails or has no results.
# https://app.tavily.com/
# TAVILY_API_KEY=
# https://dashboard.exa.ai/
# EXA_API_KEY=

# Web scraping through https://www.scraperapi.com/
# SCRAPERAPI_API_KEY=

# Email: each named bot gets its own mailbox on first use.
# Create an API key at https://console.agentmail.to/
# AGENTMAIL_API_KEY=

# Cloudflare D1 stores bots, chats and scheduled jobs when CLOUDFLARE_D1_DATABASE_ID is set.
# Create a D1 database and an API token with Account > D1 Edit permission.
# Without it, they're kept in a SQLite file: PEKKA_DATABASE_PATH, or pekka.db here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# PEKKA_DATABASE_PATH=pekka.db

# Region for new Daytona sandboxes (optional, after setting an organization default).
# DAYTONA_TARGET=eu

# Any OpenRouter model that supports tool calling (optional).
# PEKKA_MODEL=deepseek/deepseek-v4.1-flash

# Name of the persistent sandbox that acts as the agent's computer (optional).
# PEKKA_SANDBOX_NAME=pekka-computer

# Maximum model replies per task (optional).
# PEKKA_MAX_STEPS=30

# Model context window in tokens (optional). Defaults to the window OpenRouter
# lists for PEKKA_MODEL. Older messages are summarized once a prompt fills half of it.
# PEKKA_CONTEXT_WINDOW=200000

# Ask for approval before writes, commands and plugin actions (optional).
# Off by default: everything except hard-blocked commands runs without asking.
# PEKKA_REQUIRE_APPROVAL=true

# Optional sign-in with Google, so several people can each have their own bots,
# jobs and plugins. Leave PEKKA_URL unset to keep Pekka localhost-only and single-user.
# PEKKA_URL must use https:// unless it is a localhost address. Register
# <PEKKA_URL>/api/auth/google/callback as a redirect URI on the Google OAuth
# client below (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, shared with Gmail).
# PEKKA_URL=https://pekka.example.com
# Or, for a demo, turn sign-in off and share one workspace with every visitor, kept apart from
# your own. Plugins, model keys, email and jobs are off there; runs use the server's keys.
# PEKKA_PUBLIC_ACCESS=true
# Who may sign in: addresses, or @domain for every Google Workspace account of a domain, comma-separated.
# PEKKA_ALLOWED_EMAILS=alice@example.com,@yourcompany.com
# Your own Google account keeps the bots and jobs created before sign-in.
# PEKKA_OWNER_EMAIL=you@example.com
# Listen address (optional). Keep 127.0.0.1 behind a local reverse proxy.
# PEKKA_API_HOST=127.0.0.1

# Optional Notion public OAuth connection (Plugins page).
# Register this exact redirect URI in your Notion connection settings.
# Match the host and port you use to open Pekka, or use PEKKA_URL when sign-in is on.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://127.0.0.1:3000/api/plugins/notion/callback
# Generate once: openssl rand -hex 32. Keep stable to decrypt saved tokens.
# PEKKA_PLUGIN_KEY=
# Granola uses a personal API key. Todoist uses MCP OAuth with dynamic client registration.
# Todoist defaults to PEKKA_URL/api/plugins/todoist/callback (localhost:3000 locally).
# TODOIST_REDIRECT_URI=http://localhost:3000/api/plugins/todoist/callback

# Optional Google plugins: Gmail, Google Calendar (with Tasks), Google Drive
# (with Docs and Sheets) and Google Contacts (Plugins page).
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and enable the APIs for the plugins you want. GOOGLE_REDIRECT_URI is Gmail's callback;
# also register /api/plugins/calendar/callback, /api/plugins/drive/callback and
# /api/plugins/contacts/callback on the same host. Uses PEKKA_PLUGIN_KEY above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/plugins/gmail/callback

# Reading PDFs, scans and images from Drive and Gmail (optional).
# OCR downloads about 15 MB of language data on first use. Set PEKKA_OCR=false to turn it off.
# PEKKA_OCR=false
# PEKKA_TESSDATA_PATH=/tmp/pekka-tessdata

# Optional Telegram bot for messaging you (Plugins page). Create one with @BotFather.
# Use a dedicated bot: Pekka reads its updates to link your chat.
# TELEGRAM_BOT_TOKEN=

# Optional GitHub OAuth app connection (Plugins page).
# Create an OAuth app at https://github.com/settings/developers and register this
# exact callback URL. Uses PEKKA_PLUGIN_KEY above. Install gh on the Pekka server.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:3000/api/plugins/github/callback

# Optional Linear OAuth app connection (Plugins page).
# Create an OAuth application at https://linear.app/settings/api/applications/new and
# register this exact callback URL. Uses PEKKA_PLUGIN_KEY above.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_REDIRECT_URI=http://127.0.0.1:3000/api/plugins/linear/callback

# Optional Langfuse tracing: enable by setting both project API keys.
# Prompts, model replies and tool inputs/outputs are sent to your Langfuse project.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# Set false to disable tracing even when keys are present.
# LANGFUSE_TRACING_ENABLED=false

# Wispr Flow uses OAuth with automatic client registration (no API key/client secret).
# Defaults to PEKKA_URL + /api/plugins/wispr/callback, or localhost:3000 locally.
# Requires PEKKA_PLUGIN_KEY, as above.
WISPR_FLOW_REDIRECT_URI=
